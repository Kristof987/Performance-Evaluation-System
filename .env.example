# Development database; use an isolated database for tests and migration checks.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/performance_evaluation
APP_TIMEZONE=Europe/Budapest
FRONTEND_URL=http://localhost:5173

# Auth0 API token validation. Domain is a hostname without https:// or a trailing slash.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://compass.example/api

# Self-service password reset and employee sign-in invitations (Auth0 database connections only).
# Invitations create the Auth0 user with a random, never-stored password and send Auth0's
# "Change Password" email so the employee sets their own password. In the Auth0 dashboard:
#   - the database connection must allow sign-ups ("Disable Sign Ups" off);
#   - customise Branding > Email Templates > Change Password as the welcome text;
#   - if "Verify Email" is on, new employees also receive a verification email;
#   - use your own email provider in production (the built-in one is for testing).
AUTH0_CLIENT_ID=
AUTH0_DB_CONNECTION=Username-Password-Authentication
