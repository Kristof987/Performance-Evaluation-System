# Development database; use an isolated database for tests and migration checks.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/performance_evaluation
APP_TIMEZONE=Europe/Budapest
FRONTEND_URL=http://localhost:5173

# Auth0 API token validation. Domain is a hostname without https:// or a trailing slash.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://compass.example/api

# Self-service password reset (Auth0 database connections only).
AUTH0_CLIENT_ID=
AUTH0_DB_CONNECTION=Username-Password-Authentication

# Optional MFA self-service; leave BOTH unset to disable the Management API controls.
# Grant the M2M app read:authentication_methods and delete:authenticators as supported by your tenant.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
